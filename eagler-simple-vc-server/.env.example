# Bind the Node WSS relay process locally and terminate TLS at a reverse proxy.
HOST=127.0.0.1
PORT=8787

# Comma-separated high-entropy tokens. Issue a separate short-lived token per player/session in production.
EAGLER_SVC_TOKENS=replace-with-a-long-random-secret

# Exact browser Origins that may create relay sessions. A locally opened HTML client sends Origin: null.
# Do not allow null on a public service unless each session has a strong, short-lived token.
EAGLER_SVC_ALLOWED_ORIGINS=https://play.example.com

# Development only. Never enable in production.
# EAGLER_SVC_DEV_MODE=true
