# Bind the Node signaling process locally and terminate TLS at a reverse proxy.
HOST=127.0.0.1
PORT=8787

# Comma-separated high-entropy tokens. Issue a separate short-lived token per player/session in production.
EAGLER_SVC_TOKENS=replace-with-a-long-random-secret

# Exact browser Origins that may create signaling sessions. A locally opened HTML client sends Origin: null.
# Do not allow null on a public server unless each session uses a strong, short-lived token.
EAGLER_SVC_ALLOWED_ORIGINS=https://play.example.com

# Optional authenticated ICE configuration. Include TURN for real-world NAT traversal.
# EAGLER_SVC_ICE_SERVERS_JSON=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"replace-me","credential":"replace-me"}]

# Development only. Never enable in production.
# EAGLER_SVC_DEV_MODE=true
